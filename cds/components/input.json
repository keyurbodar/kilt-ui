  "css": ".inp {font-family:var(--font-sans);-webkit-font-smoothing:antialiased;letter-spacing:var(--tracking-snug);box-sizing:border-box;display:flex;align-items:center;width:100%;min-width:0;border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--font-weight-normal);color:var(--color-foreground);overflow:hidden;white-space:nowrap}\n.inp .v:empty {display:none}\n.inp .v:not(:empty) + .ph {display:none}\n.inp .ph {color:var(--color-muted-foreground-3)}\n.inp[data-variant=\"default\"] {background:var(--color-input);border:var(--spacing-hairline) solid var(--color-border-2)}\n.inp[data-variant=\"blank\"] {background:transparent;border:0}\n.inp[data-variant=\"ghost\"] {width:auto;background:transparent;border:var(--spacing-hairline) solid transparent;font-weight:var(--font-weight-medium);transition:border-color 150ms,background-color 150ms}\n.inp[data-variant=\"ghost\"] .ph {color:var(--color-foreground)}\n.inp[data-variant=\"ghost\"]:hover, .inp[data-variant=\"ghost\"][data-state=\"hover\"], .inp[data-variant=\"ghost\"][data-state=\"focus\"] {border-color:var(--color-border-2);background:var(--color-input)}\n.inp[data-state=\"focus\"] {outline:1px solid var(--focus-ring,var(--color-ring));outline-offset:-1px}\n.inp[data-state=\"invalid\"] {border-color:var(--color-destructive)}\n.inp[data-state=\"disabled\"] {cursor:not-allowed;opacity:.55}\n.inp[data-size=\"xs\"] {height:var(--spacing-control-xs);padding:0 6px;font-size:var(--text-xs)}\n.inp[data-size=\"sm\"] {height:var(--spacing-control-sm);padding:0 8px}\n.inp[data-size=\"base\"] {height:var(--spacing-control-base);padding:0 10px}\n.inp[data-font=\"mono\"] {font-family:var(--font-mono);font-size:var(--text-xs)}\n.inp[data-font=\"numeric\"] {font-variant-numeric:tabular-nums}",
