  "css": ".cp {font-family:var(--font-sans);-webkit-font-smoothing:antialiased;letter-spacing:var(--tracking-snug);box-sizing:border-box;--sh-overlay:0 3px 8px rgb(0 0 0/.13),0 2px 5px rgb(0 0 0/.13),0 1px 1px rgb(0 0 0/.13);position:relative;display:flex;width:720px;max-width:100%;min-height:0;flex-direction:column;overflow:hidden;border-radius:var(--radius-xl);border:var(--spacing-hairline) solid var(--color-border-2);background:var(--color-popover);box-shadow:var(--sh-overlay);color:var(--color-foreground)}\n:where([data-doop-theme=\"light\"]) .cp {--sh-overlay:0 6px 18px rgb(0 0 0/.03),0 3px 9px rgb(0 0 0/.04),0 1px 1px rgb(0 0 0/.05);}\n.cp .ir {display:flex;flex-shrink:0;align-items:center}\n.cp .in {display:flex;align-items:center;height:44px;flex:1;min-width:0;padding:0 16px;font-size:var(--text-sm);font-weight:var(--font-weight-normal)}\n.cp .ph {color:var(--color-muted-foreground-3)}\n.cp .nt {display:flex;flex-shrink:0;align-items:center;padding-right:8px;position:relative}\n.cp .nt .btn {padding-right:30px}\n.cp .tab {position:absolute;right:16px;top:50%;transform:translateY(-50%);display:flex}\n.cp .sep {height:1px;background:var(--color-border-1);flex-shrink:0}\n.cp .fl {display:flex;flex-shrink:0;align-items:center;gap:2px;padding:6px 6px 0;overflow-x:auto}\n.cp .f {display:inline-flex;height:var(--spacing-control-sm);flex-shrink:0;cursor:pointer;align-items:center;border-radius:var(--radius-md);padding:0 10px;font-size:var(--text-xs);font-weight:var(--font-weight-medium);white-space:nowrap;color:var(--color-muted-foreground-2);user-select:none;transition:color 100ms}\n.cp .f:hover {color:var(--color-foreground)}\n.cp .f.on {background:var(--color-secondary);color:var(--color-foreground)}\n.cp .ls {max-height:min(400px,60vh);min-height:0;flex:1;overflow-y:auto;padding:6px}\n.cp .gr {display:flex;flex-direction:column;gap:1px}\n.cp .gl {display:flex;min-height:28px;align-items:center;padding:0 10px;font-size:var(--text-xs);font-weight:var(--font-weight-medium);color:var(--color-muted-foreground-2);letter-spacing:var(--tracking-normal)}\n.cp .ft {display:flex;height:40px;flex-shrink:0;align-items:center;gap:16px;border-top:var(--spacing-hairline) solid var(--color-border-1);padding:0 16px}\n.cp .fm {display:inline-flex;align-items:center;height:16px;color:var(--color-muted-foreground-3)}\n.cp .mk {height:100%;width:auto}\n.cp .hints {margin-left:auto;display:flex;align-items:center;gap:16px}\n.cp .h {display:flex;align-items:center;gap:6px;font-size:var(--text-xs);font-weight:var(--font-weight-normal);color:var(--color-muted-foreground-2);letter-spacing:var(--tracking-normal)}\n.cp .kg {display:flex;align-items:center;gap:2px}",
