  "css": ".mr {font-family:var(--font-sans);-webkit-font-smoothing:antialiased;letter-spacing:var(--tracking-snug);box-sizing:border-box;position:relative;display:flex;width:100%;min-width:0;cursor:pointer;align-items:center;gap:8px;border-radius:var(--radius-md);padding:0 8px;text-align:left;font-size:var(--text-sm);font-weight:var(--font-weight-normal);outline:none;user-select:none;color:var(--color-foreground)}\n.mr svg {pointer-events:none;flex-shrink:0;width:var(--spacing-icon-sm);height:var(--spacing-icon-sm)}\n.mr .ico {display:flex;width:var(--spacing-icon-sm);height:var(--spacing-icon-sm);flex-shrink:0;align-items:center;justify-content:center;color:var(--color-icon-muted)}\n.mr .lb {min-width:0;flex:1;display:flex;flex-direction:column;overflow:hidden;white-space:nowrap}\n.mr .ds {display:none;font-size:var(--text-xs);color:var(--color-muted-foreground-2)}\n.mr[data-density=\"rich\"] .ds {display:block}\n.mr .tr {margin-left:auto;display:flex;flex-shrink:0;align-items:center;gap:6px;font-size:var(--text-sm);color:var(--color-muted-foreground-1)}\n.mr .k {display:inline-flex;align-items:center;justify-content:center;height:16px;min-width:16px;border-radius:var(--radius-sm);background:var(--color-secondary);padding:0 4px;font-family:var(--font-sans);font-size:var(--text-xs);color:var(--color-muted-foreground-1)}\n.mr .chk {margin-left:auto;display:flex;color:var(--color-foreground)}\n.mr[data-density=\"default\"] {height:var(--spacing-menu-row)}\n.mr[data-density=\"rich\"] {height:auto;min-height:36px;padding-top:4px;padding-bottom:4px}\n.mr[data-density=\"palette\"] {height:var(--spacing-palette-row);gap:10px;border-radius:.5rem;padding:0 10px}\n.mr[data-density=\"palette\"] svg, .mr[data-density=\"palette\"] .ico {width:var(--spacing-icon-base);height:var(--spacing-icon-base)}\n.mr:hover, .mr[data-state=\"highlighted\"] {background:var(--menu-row-highlight,var(--color-popover-hover))}\n.mr[data-intent=\"danger\"] {color:var(--color-destructive);--menu-row-highlight:var(--color-destructive-soft)}\n.mr[data-intent=\"danger\"] .ico {color:var(--color-destructive)}\n.mr[data-state=\"disabled\"] {pointer-events:none;opacity:.5}\n.mr[data-density=\"palette\"] .tr {font-size:var(--text-xs);color:var(--color-muted-foreground-2)}\n.mr .kg {display:flex;align-items:center;gap:2px}\n.mr .meta {margin-left:auto;flex-shrink:0;min-width:32px;text-align:right;font-variant-numeric:tabular-nums;font-size:var(--text-xs);color:var(--color-muted-foreground-2)}",
